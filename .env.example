# ── AI Travel Agent configuration ─────────────────────────────
# Copy to .env and fill in. Every key below has a free tier.

# LLM backend: gemini | groq
LLM_PROVIDER=gemini

# Google AI Studio (free quota): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq console (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Duffel (flights) — free signup, test mode, no card:
# https://duffel.com → dashboard → create a test API key (starts with duffel_test_)
DUFFEL_API_KEY=

# LiteAPI (hotels) — free sandbox key, no card:
# https://dashboard.liteapi.travel → Profile → copy the sandbox key (starts with sand_)
LITEAPI_API_KEY=

# OpenWeather (free: 1,000 calls/day): https://openweathermap.org/api
OPENWEATHER_API_KEY=

# OpenTripMap (optional POI enrichment, free): https://opentripmap.io
OPENTRIPMAP_API_KEY=

# Safety: live ticketing stays OFF unless explicitly enabled.
# Even with confirmed=true bookings, v1 will not issue real tickets
# unless ENABLE_LIVE_BOOKING=true.
ENABLE_LIVE_BOOKING=false

# Max tool-call rounds per trip plan
MAX_TOOL_ITERATIONS=12
